        {
          "type": "header",
          "text": "採取・挿入の演出"
        },
        {
          "id": "bDropBottle:DNA",
          "text": "採取した瓶を足元に落とす",
          "type": "toggle",
          "help": "オン：採取した精液の瓶が相手の足元に落ち、拾って入手。オフ：直接インベントリへ",
          "valueOptions": {
            "sourceType": "ModSettingBool"
