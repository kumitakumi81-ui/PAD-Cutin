        {
          "id": "fLeakSlowmo:Scene",
          "text": "漏れた瞬間のスロー",
          "type": "slider",
          "help": "0.5秒だけ時間がこの速さになる（1で無効）",
          "valueOptions": { "min": 0.1, "max": 1.0, "step": 0.05, "formatString": "{2}", "sourceType": "ModSettingFloat" }
