        {
          "id": "fLeakChance:Scene",
          "text": "漏れる確率",
          "type": "slider",
          "help": "注いだあと漏れてくる確率",
          "valueOptions": {
            "min": 0.0,
            "max": 1.0,
            "step": 0.05,
            "formatString": "{2}",
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fLeakSeconds:Scene",
          "text": "漏れている秒数",
          "type": "slider",
          "help": "脚を閉じ気味に歩く・垂れる見た目が続く時間",
          "valueOptions": {
            "min": 10.0,
            "max": 180.0,
            "step": 5.0,
            "formatString": "{0}",
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "bLeakCamera:Scene",
