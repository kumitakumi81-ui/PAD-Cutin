        {
          "id": "bCamera:Camera",
          "text": "カメラワーク",
          "type": "toggle",
          "help": "採取・挿入のときのカメラ演出（黒帯・スロー付き）のあり／なし",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
